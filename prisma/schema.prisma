datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String
  marca       String
  genero      String   @default("Hombre")
  categoria   String   @default("Calzado")
  descripcion String?
  precio      Float
  talla       String
  imagenUrl   String
  imagenes    String?  // Guarda el array de imágenes en formato JSON
  createdAt   DateTime @default(now())
}

model Orden {
  id          Int      @id @default(autoincrement())
  cliente     String
  telefono    String
  direccion   String
  codigo      String?
  total       Float
  productos   String   // Guarda el carrito en formato JSON
  createdAt   DateTime @default(now())
}

model Anuncio {
  id        String   @id @default(uuid())
  titulo    String   // El texto principal del anuncio
  imagenUrl String?  // El signo ? significa que la imagen es opcional
  activo    Boolean  @default(true) // Para apagarlo sin tener que borrarlo
  createdAt DateTime @default(now())
}
