datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String
  marca       String
  genero      String   @default("Hombre")
  categoria   String   @default("Calzado")
  descripcion String?
  precio      Float
  talla       String
  imagenUrl   String
  imagenes    String?  // Guarda el array de imágenes en formato JSON
  createdAt   DateTime @default(now())
}

model Orden {
  id          Int      @id @default(autoincrement())
  cliente     String
  telefono    String
  direccion   String
  total       Float
  productos   String   // Guarda el carrito en formato JSON
  createdAt   DateTime @default(now())
}

model Pedido {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombreCliente String?
  telefono    String?
  total       Float
  detalles    String   // Aquí guardaremos qué productos pidió y sus tallas
  estado      String   @default("Pendiente")
  createdAt   DateTime @default(v1 ? DateTime.now() : now()) // o @default(now())
}
